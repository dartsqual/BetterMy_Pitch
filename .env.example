# ── LLM provider ────────────────────────────────────────────────
# openrouter (default) | anthropic | gemini | mock
LLM_PROVIDER="openrouter"

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Fast model for the buyer roleplay + live coach, stronger model for the scorecard.
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-5.5"
OPENROUTER_EVAL_MODEL="anthropic/claude-sonnet-5.5"
# Free alternative (works with a $0-limit key; rate-limited):
#   OPENROUTER_CHAT_MODEL="baidu/ernie-5.5-flash-preview:free"
#   OPENROUTER_EVAL_MODEL="nvidia/nemotron-3.5-super-vl:free"
# Token caps (reasoning models need room to think):
# LLM_CHAT_MAX_TOKENS=4000
# LLM_EVAL_MAX_TOKENS=16000

# Direct Anthropic (optional, LLM_PROVIDER="anthropic")
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL="claude-haiku-5-5"
ANTHROPIC_EVAL_MODEL="claude-sonnet-5-5"

# Direct Google Gemini (optional, LLM_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EVAL_MODEL="gemini-2.5-flash"

# ── Database ────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
